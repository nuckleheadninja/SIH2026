      "rule_name": "Manufacturer Name and Address Declaration",
      "rule_number": "Rule 6(1)(a)",
      "mandatory": true,
      "description": "Every package shall bear thereon the name and address of the manufacturer or packer or importer.",
      "keywords": ["manufacturer", "packer", "importer", "address", "name"]
    },
