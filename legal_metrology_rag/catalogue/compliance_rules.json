      "description": "The common or generic names of the commodity contained in the package.",
      "keywords": ["generic name", "common name", "commodity"]
    },
    {
      "rule_id": "LMR_RULE_06_1_D",
      "rule_name": "Net Quantity Declaration",
      "rule_number": "Rule 6(1)(d)",
      "mandatory": true,
      "description": "Net quantity, in terms of standard unit of weight or measure or number.",
      "keywords": ["net quantity", "net wt", "net volume", "g", "kg", "ml", "l"]
    },
    {
