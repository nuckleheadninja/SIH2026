      "rule_number": "Rule 6(1)(b)",
      "mandatory": true,
      "description": "Every imported package shall bear the name of the country of origin.",
      "keywords": ["country of origin", "imported", "made in"]
    },
    {
      "rule_id": "LMR_RULE_06_1_C",
      "rule_name": "Generic or Common Name Declaration",
