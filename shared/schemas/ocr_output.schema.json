{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCROutput",
  "description": "Output produced by the OCR detection and layout analysis module",
  "type": "object",
  "properties": {
    "image_id": {
      "type": "string"
    },
    "text_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height]"
          },
          "layout": {
            "type": "object",
            "properties": {
              "font_height_px": {
                "type": "number"
              },
              "position": {
                "type": "string"
              }
            }
          }
        },
        "required": ["text", "confidence", "bbox"]
      }
    }
  },
  "required": ["image_id", "text_blocks"]
}
